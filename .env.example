# ═══════════════════════════════════════════════════
#  Contrepoint — Variables d'environnement
#  Copier ce fichier en .env et remplir les valeurs.
#  NE JAMAIS committer .env dans git.
# ═══════════════════════════════════════════════════

# ── Web3Forms (formulaire de contact) ─────────────
# Obtenir sur https://web3forms.com (gratuit)
W3F_KEY=your_web3forms_access_key_here

# ── LemonSqueezy ──────────────────────────────────
# Clé API LemonSqueezy (dashboard → API Keys)
LEMONSQUEEZY_API_KEY=your_lemonsqueezy_api_key_here

# Signing secret du webhook (dashboard → Webhooks → Signing Secret)
LS_WEBHOOK_SECRET=your_webhook_signing_secret_here

# Store ID LemonSqueezy (visible dans l'URL du dashboard)
LS_STORE_ID=your_store_id_here

# ── Google Drive API ───────────────────────────────
# Créer sur https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_API_KEY=your_google_api_key_here

# ── Serveur ────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Session (si cookies HTTPOnly) ─────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=generate_a_long_random_string_here
